<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="XdppWallpaperPreview" parent="AdwBreakpointBin">
    <property name="width-request">300</property>
    <property name="height-request">300</property>
    <property name="hexpand">1</property>
    <property name="vexpand">1</property>
    <property name="child">
      <object class="GtkBox" id="box">
        <property name="hexpand">1</property>
        <property name="vexpand">1</property>
        <property name="spacing">6</property>
        <property name="orientation">horizontal</property>
        <child>
          <object class="GtkAspectFrame" id="frame">
            <property name="obey-child">0</property>
            <child>
              <object class="GtkOverlay">
                <property name="visible" bind-source="XdppWallpaperPreview" bind-property="show_home" bind-flags="sync-create"/>
                <property name="child">
                  <object class="GtkPicture" id="home_pic">
                    <property name="hexpand">1</property>
                    <property name="vexpand">1</property>
                  </object>
                </property>
                <child type="overlay">
                  <object class="GtkCenterBox">
                    <property name="hexpand">1</property>
                    <property name="valign">start</property>
                    <style>
                      <class name="panel"/>
                    </style>
                    <child type="start">
                      <object class="GtkBox">
                        <property name="spacing">4</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">network-cellular-signal-good-symbolic</property>
                            <property name="pixel-size">6</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="1">4G</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">network-wireless-symbolic</property>
                            <property name="pixel-size">6</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">bluetooth-active-symbolic</property>
                            <property name="pixel-size">6</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child type="center">
                      <object class="GtkLabel" id="home_time">
                        <property name="hexpand">1</property>
                        <property name="label" translatable="1">21 Jan 03:16</property>
                      </object>
                    </child>
                    <child type="end">
                      <object class="GtkBox">
                        <property name="spacing">4</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">battery-low-symbolic</property>
                            <property name="pixel-size">6</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkAspectFrame">
            <property name="obey-child">0</property>
            <property name="ratio" bind-source="frame" bind-property="ratio" bind-flags="sync-create"/>
            <child>
              <object class="GtkOverlay">
                <property name="visible" bind-source="XdppWallpaperPreview" bind-property="show_lockscreen" bind-flags="sync-create"/>
                <property name="child">
                  <object class="GtkPicture" id="lockscreen_pic">
                    <property name="hexpand">1</property>
                    <property name="vexpand">1</property>
                  </object>
                </property>
                <child type="overlay">
                  <object class="GtkCenterBox">
                    <property name="hexpand">1</property>
                    <property name="valign">start</property>
                    <style>
                      <class name="panel"/>
                    </style>
                    <child type="start">
                      <object class="GtkBox">
                        <property name="spacing">4</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">network-cellular-signal-good-symbolic</property>
                            <property name="pixel-size">6</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="1">4G</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">network-wireless-symbolic</property>
                            <property name="pixel-size">6</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">bluetooth-active-symbolic</property>
                            <property name="pixel-size">6</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child type="end">
                      <object class="GtkBox">
                        <property name="spacing">4</property>
                        <child>
                          <object class="GtkImage">
                            <property name="icon-name">battery-low-symbolic</property>
                            <property name="pixel-size">6</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="overlay">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="valign">center</property>
                    <property name="vexpand">1</property>
                    <property name="spacing">5</property>
                    <property name="margin-bottom">16</property>
                    <child>
                      <object class="GtkLabel" id="lockscreen_time">
                        <property name="valign">center</property>
                        <property name="hexpand">1</property>
                        <property name="single-line-mode">1</property>
                        <style>
                          <class name="lockscreen-time"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="lockscreen_date">
                        <property name="valign">center</property>
                        <property name="label" translatable="1">21 Jan</property>
                        <style>
                          <class name="lockscreen-date"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 360px</condition>
        <setter object="box" property="orientation">vertical</setter>
      </object>
    </child>
  </template>
</interface>
